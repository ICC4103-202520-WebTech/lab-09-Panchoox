<%= form_with(model: recipe, local: true) do |form| %>
  <% if recipe.errors.any? %>
    <div class="alert alert-danger">
      <p><strong><%= pluralize(recipe.errors.count, "error") %> impiden guardar:</strong></p>
      <ul class="mb-0">
        <% recipe.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, "Título", class: "form-label" %>
    <%= form.text_field :title, class: "form-control", autofocus: true %>
  </div>

  <div class="mb-3">
    <%= form.label :cook_time, "Tiempo de cocción (min)", class: "form-label" %>
    <%= form.number_field :cook_time, class: "form-control", min: 1 %>
  </div>

  <div class="mb-3">
    <%= form.label :difficulty, "Dificultad", class: "form-label" %>
    <%= form.select :difficulty, %w[Easy Medium Hard], { prompt: "Selecciona" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :instructions, "Instrucciones", class: "form-label" %>
    <%= form.rich_text_area :instructions, class: "form-control" %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit (recipe.persisted? ? "Actualizar" : "Crear"), class: "btn btn-primary" %>
    <%= link_to "Cancelar", (recipe.persisted? ? recipe_path(recipe) : recipes_path), class: "btn btn-secondary" %>
  </div>
<% end %>