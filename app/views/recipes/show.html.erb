<div class= "row">
  <div class= "col-md-8">
    <h1 class="mb-0"><%= @recipe.title %></h1>
    
    <div class="mb-3">
      <small class="text-muted">
        Creada por: <strong><%= user_displayName(@recipe.user) %></strong>
        el <%= @recipe.created_at.strftime("%d/%m/%Y") %>
      </small>
    </div>
  </div>
</div>
<div class="mb-3">
  <%= link_to "← Volver", recipes_path, class: "btn btn-sm btn-outline-secondary" %>
</div>

<div class="card">
  <div class="card-header bg-primary text-white">
    <h2 class="mb-0"><%= @recipe.title %></h2>
  </div>
  <div class="card-body">
    <p><strong>⏱ Tiempo de cocción:</strong> <%= @recipe.cook_time %> minutos</p>
    <p><strong> Dificultad:</strong> 
      <span class="badge bg-<%= difficulty_badge_color(@recipe.difficulty) %>">
        <%= @recipe.difficulty %>
      </span>
    </p>
    <hr>
    <h5> Instrucciones</h5>
    <div class="border rounded p-3 bg-light trix-content">
      <%= @recipe.instructions %>
    </div>
  </div>
  <div class="card-footer d-flex gap-2">
    <% if user_signed_in? && current_user == @recipe.user %>
      <%= link_to "Editar", edit_recipe_path(@recipe), class: "btn btn-warning" %>
      <%= button_to "Eliminar", @recipe, method: :delete,
            data: { turbo_confirm: "¿Estás seguro?" },
            class: "btn btn-danger" %>
    <% end %>
  </div>
</div>