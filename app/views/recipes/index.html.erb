<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0"> Todas las Recetas</h1>
  <% if user_signed_in? %>
    <%= link_to " Nueva Receta", new_recipe_path, class: "btn btn-primary" %>
  <% end %>
</div>

<% if @recipes.any? %>
  <div class="row">
    <% @recipes.each do |recipe| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= recipe.title %></h5>
            <p class="card-text">
              <small class="text-muted">Por: <%= user_displayName(recipe.user) %></small>
            </p>
            <p class="card-text">
              <strong> Tiempo:</strong> <%= recipe.cook_time %> min | 
              <strong> Dificultad:</strong> 
              <span class="badge bg-<%= difficulty_badge_color(recipe.difficulty) %>">
                <%= recipe.difficulty %>
              </span>
            </p>
          </div>
          <div class="card-footer d-flex gap-2">
            <%= link_to "Ver Receta", recipe_path(recipe), class: "btn btn-sm btn-primary" %>
            
            <% if user_signed_in? && current_user == recipe.user %>
              <%= link_to "Editar", edit_recipe_path(recipe), class: "btn btn-sm btn-warning" %>
              <%= button_to "Eliminar", recipe, method: :delete, 
                  data: { turbo_confirm: "¿Estás seguro?" }, 
                  class: "btn btn-sm btn-danger" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">
    No hay recetas. 
    <% if user_signed_in? %>
      <%= link_to "Crea la primera!", new_recipe_path, class: "alert-link" %>
    <% else %>
      <%= link_to "Inicia sesión", new_user_session_path, class: "alert-link" %> para crear una.
    <% end %>
  </div>
<% end %>