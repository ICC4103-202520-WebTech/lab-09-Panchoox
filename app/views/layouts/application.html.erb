<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Recipe Book" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# (Opcional) manifiesto PWA si lo habilitas después %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= yield :head %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-dark bg-dark mb-4 navbar-expand-lg">
      <div class="container">
        <%= link_to "Recipe Book", root_path, class: "navbar-brand" %>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <% if user_signed_in? %>
              <!-- Usuario autenticado -->
              
              <li class="nav-item">
                <%= link_to "Mis Recetas", recipes_path, class: "nav-link" %>
              </li>
              <% if can?(:create, Recipe) %>
                <li class="nav-item">
                  <%= link_to "Nueva Receta", new_recipe_path, class: "nav-link" %>
                </li>
              <% end %>
              <li class="nav-item">
                <span class="nav-link">
                  👋 Hola, <strong><%= user_displayName(current_user) %></strong>
                  <% if can?(:manage, :all) %>
                    <span class="badge bg-warning text-dark ms-2">Admin</span>
                  <% end %>
                </span>
              </li>
              <li class="nav-item">
                <%= button_to "Cerrar Sesión", destroy_user_session_path, 
                    method: :delete, 
                    class: "btn btn-outline-danger btn-sm",
                    form: { style: "display: inline-block;" } %>
              </li>
            <% else %>
              <!-- Usuario no autenticado -->

              <li class="nav-item">
                <%= link_to "Ver Recetas", recipes_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Iniciar Sesión", new_user_session_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Registrarse", new_user_registration_path, class: "btn btn-primary btn-sm" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container">
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <!-- CONTENIDO -->
      <%= yield %>
    </div>
  </body>
</html>